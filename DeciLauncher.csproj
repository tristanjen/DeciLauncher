<!--
  Deci Launcher 项目配置
  目标框架：.NET 10.0
  输出类型：WinExe（生产模式）/ Exe（Debug 模式）
  支持平台：win-x64, win-arm64, linux-x64, linux-arm64, osx-x64, osx-arm64
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- 输出类型：WinExe 避免 Windows 上弹出控制台窗口 -->
        <OutputType>WinExe</OutputType>
        <!-- 目标框架版本 -->
        <TargetFramework>net10.0</TargetFramework>
        <!-- 支持任意 CPU 架构 -->
        <Platforms>AnyCPU</Platforms>
        <!-- 启用 Per-Monitor DPI 感知（暂用 V1 避免恢复后自动缩放） -->
        <ApplicationDpiAwareness>PerMonitor</ApplicationDpiAwareness>
        <!-- 启用全局隐式 using（自动引用常用命名空间） -->
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 启用可空引用类型检查 -->
        <Nullable>enable</Nullable>
        <!-- 使用默认语言版本（.NET 10 默认对应 C# 14） -->
        <LangVersion>default</LangVersion>
        <!-- 启用最新静态分析规则（CA 系列），发现问题即时修复或显式抑制 -->
        <AnalysisLevel>latest</AnalysisLevel>
        <!-- IL2026：PublishTrimmed 下反射序列化必然告警。本启动器的全部前端消息依赖反射序列化
             匿名对象（JsonSerializerIsReflectionEnabledByDefault 已显式覆盖为 true），
             且 TrimmerRootAssembly 已保留 MinecraftLaunch 反射路径，此为显式设计决策而非遗漏 -->
        <NoWarn>$(NoWarn);IL2026</NoWarn>
        <!-- 生成嵌入式文件清单（用于从程序集中提供静态资源） -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <!-- 发布为单文件应用（含自解压，原生 DLL 打包进 exe） -->
        <PublishSingleFile>true</PublishSingleFile>
        <!-- 原生库嵌入自解压包（消除外部 .dll 文件） -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- 自包含发布：运行时内嵌，无需用户安装 .NET 运行时（仅发布时生效，普通 build/test 保持框架依赖） -->
        <SelfContained Condition="'$(IsPublishing)' == 'true'">true</SelfContained>
        <!-- 启用 IL 裁剪（partial 模式：仅裁剪明确标记的程序集，兼容反射与 ASP.NET 托管） -->
        <PublishTrimmed>true</PublishTrimmed>
        <!-- PublishTrimmed 会自动把 JsonSerializerIsReflectionEnabledByDefault 注入为 false，
             而本启动器的全部前端消息依赖反射序列化匿名对象，显式覆盖回 true -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <!-- 关闭托管侧调试符号生成 -->
        <DebugType>none</DebugType>
        <!-- 支持的运行时标识符列表（用于多平台发布） -->
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <!-- 应用版本号 -->
        <Version>1.0.0-beta.2</Version>
        <!-- 程序名称 -->
        <Title>Deci Launcher</Title>
        <AssemblyName>Deci Launcher</AssemblyName>
        <!-- 产品名称 -->
        <Product>Deci Launcher</Product>
        <!-- 开发公司 -->
        <Company>Decibyte</Company>
        <!-- 作者署名 -->
        <Authors>Tristan Jen</Authors>
        <!-- 版权声明 -->
        <Copyright>Decibyte © 2026</Copyright>
        <!-- 应用描述 -->
        <Description>A cross-platform Minecraft Launcher.</Description>
        <!-- Windows 可执行文件图标 -->
        <ApplicationIcon>packaging\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!-- 从程序集内嵌资源中提供静态文件（Photino 内嵌静态文件服务器依赖） -->
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
        <!-- 控制台日志记录：.NET 10 框架自带 Microsoft.Extensions.Logging.Console，无需单独引用 -->
        <!-- Minecraft 启动核心库（Mojang 账户认证 + 版本安装 + 启动） -->
        <PackageReference Include="MinecraftLaunch" Version="4.0.7" />
        <!-- Photino 桌面窗口框架（WebView2 / WebKit 跨平台封装） -->
        <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <ItemGroup>
        <!-- ASP.NET Core 共享框架（内嵌文件服务器依赖 Kestrel） -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup>
        <!-- CI 构建标记：由命令行 -p:CI_BUILD=true 注入编译常量，
             使 DECILAUNCHER_PORT/TOKEN 环境变量仅在 CI 产物上生效（不可被用户环境变量伪造） -->
        <DefineConstants Condition="'$(CI_BUILD)' == 'true'">$(DefineConstants);CI_BUILD</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!--
          将 v17 输出目录下的所有文件作为嵌入式资源
          Vite 构建输出到 Resources/wwwroot/，此处作为内嵌资源提供静态文件服务
        -->
        <EmbeddedResource Include="Resources\wwwroot\**" LinkBase="Resources\wwwroot" />
    </ItemGroup>

    <ItemGroup>
        <!--
          主项目默认 glob 会把嵌套的 DeciLauncher.Tests 目录（含其 bin/obj 生成文件）一并编译，
          导致测试项目的 AssemblyInfo 与主项目重复（CS0579）。显式排除整个测试项目目录。
        -->
        <Compile Remove="DeciLauncher.Tests\**" />
        <EmbeddedResource Remove="DeciLauncher.Tests\**" />
        <Content Remove="DeciLauncher.Tests\**" />
        <None Remove="DeciLauncher.Tests\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- 裁剪器根程序集：保留 MinecraftLaunch 库所需的程序集。
             启动器的反射赋值（JavaEntry.JavaPath / MinecraftProcess.Process，均为 init-only 属性）
             已收敛到 Launching/MinecraftLaunchFallbacks.cs 单一入口 -->
        <TrimmerRootAssembly Include="MinecraftLaunch" />
        <TrimmerRootAssembly Include="MinecraftLaunch.Base" />
    </ItemGroup>

    <ItemGroup>
        <!-- 允许测试程序集访问 internal 成员（Launching/ 下的纯函数类） -->
        <InternalsVisibleTo Include="DeciLauncher.Tests" />
    </ItemGroup>

</Project>
